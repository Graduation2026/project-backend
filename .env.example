# =============================================================================
# Sentinel AI — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# Ghidra installation directory (used inside Docker; override for local dev)
# GHIDRA_INSTALL_DIR=/opt/ghidra

# Google GenAI — used for RAG report generation and chatbot
# Free API key from: https://aistudio.google.com/apikey
# Model: gemma-4-31b-it (free tier: 15 RPM, unlimited TPM, 1500 RPD)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemma-4-31b-it

# ChromaDB reference directory (HuggingFace local embeddings, no API key needed)
CHROMA_REF_DIR=./temp/chroma_db_reference

# Legacy providers (no longer used by default)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_LLM_MODEL=qwen3:8b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# AGENTROUTER_API_KEY=your_agentrouter_api_key_here
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# AGENTROUTER_MODEL=claude-3-5-sonnet

# CORS allowed origins (comma-separated). Leave empty to deny all cross-origin requests.
# CORS_ORIGINS=http://localhost:9090,http://localhost:8000

# Optional API key authentication. Set a value to require X-API-Key header on /analyze.
# SENTINEL_API_KEY=your_admin_key_here

# Ensemble mode and weights
# ENSEMBLE_MODE=hybrid
# ENSEMBLE_GNN_WEIGHT=0.7

# Temp directories
# FEATURES_DIR=./temp/features
# _JAVA_OPTIONS=-Xmx2G
